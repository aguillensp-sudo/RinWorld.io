# Copia este fichero a .env y rellena los valores. `.env` está en .gitignore.
# CLAUDE.md §1: ninguna credencial en ningún fichero versionado, nunca.

# Proyecto Supabase del MVP (troxminloxkjwihwfevs, eu-west-1).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PUBLICABLE (sb_publishable_…), no la de servicio. Va al navegador a
# propósito: lo que protege los datos es RLS, no el secreto de esta clave.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cuentas de desarrollo para el e2e. Sin ellas, la suite de la puerta se salta
# con un mensaje en vez de fallar.
E2E_ALPHA_EMAIL=alpha@bearingworld.test
E2E_ALPHA_PASSWORD=
E2E_ALPHA_ORG=Rodamientos Ibéricos
E2E_BETA_EMAIL=beta@bearingworld.test
E2E_BETA_PASSWORD=
E2E_BETA_ORG=Nordwälz Lager

# EDITOR (no ADMIN) de Nordwälz Lager, anadido el 5-sep-2026: prueba D-7/D-8 y la
# rama de `caller_bypasses_visibility_scope()` que ningun ADMIN ejercita (F-149).
# Llevaba desde entonces en `app/.env` y NO aqui; se anade el 11-sep.
E2E_EDITOR_EMAIL=editor@bearingworld.test
E2E_EDITOR_PASSWORD=
E2E_EDITOR_ORG=Nordwälz Lager

# Operador de Plataforma (0028). NO tiene organizacion, y por eso no hay `_ORG`:
# decide sobre organizaciones que todavia no existen. Hace falta para el e2e de
# ADMIN-01, que sin esta cuenta no se puede escribir.
#
# ⚠ La cuenta se crea en el panel de Supabase (Authentication > Add user, con
# "Auto Confirm User"), NO por SQL: sembrar `auth.users` a mano fue lo que
# provoco F-013, y una cuenta sembrada no esta creada hasta que hace login
# contra la API real. Despues hay que darla de alta en `platform_operators`, o
# la sesion la tratara como cuenta a medio provisionar.
#
# ⚠ EN GITHUB SOLO VA LA CONTRASENA. El correo no es un secreto -- esta aqui en
# claro, en este mismo fichero -- y un secreto de mas es un sitio de mas donde
# puede faltar sin que nadie se entere (F-071). Cuando exista el e2e de ADMIN-01,
# `E2E_OPERATOR_EMAIL` va LITERAL en `ci.yml`, con el mismo criterio con el que
# ya van alli `VERCEL_ORG_ID` y `VERCEL_PROJECT_ID` (CLAUDE.md §10.2).
E2E_OPERATOR_EMAIL=operador@bearingworld.test
E2E_OPERATOR_PASSWORD=

# Claves de demo deterministas (D-08-01 a). OPCIONAL.
#
#   ausente → camino real del MVP: par X25519 aleatorio por sesión, que se
#             pierde al recargar (CLAUDE.md §4). Lo cifrado antes deja de leerse
#             y la pantalla lo dice: "Contenido cifrado — introduce tu frase de
#             seguridad para ver". Es el comportamiento correcto, no un fallo.
#   presente → las claves de cada miembro salen siempre iguales, así que la
#             siembra cifrada se lee en cualquier sesión y en cualquier
#             navegador. Es lo que hace posible el panel de vista-servidor del
#             día 11 (Plan §3).
#
# ⚠ QUIEN TENGA ESTA SEMILLA TIENE TODAS LAS PRIVADAS DE LA DEMO. Sirve para
# datos inventados y para nada más: NO es ADR-001 y no debe existir en V1.
# El servidor sigue sin ver nada; lo único que se relaja es de dónde sale la
# clave. La misma semilla tiene que usarla el script de siembra
# (supabase/seed/generate-demo-content.mjs) y la app.
VITE_DEMO_KEY_SEED=

# Proyecto Supabase AISLADO de demo/e2e (entregable 3 de Fundación V1, F-149).
# Distinto del proyecto de arriba a propósito: aquí vive lo que CI resetea en
# cada corrida, para que dejar de tocar el proyecto de producción/demo real.
SUPABASE_E2E_URL=https://TU-PROYECTO-E2E.supabase.co
SUPABASE_E2E_PUBLISHABLE_KEY=sb_publishable_...
# service_role: NUNCA en un fichero versionado. Dashboard > Settings > API.
SUPABASE_E2E_SERVICE_KEY=
